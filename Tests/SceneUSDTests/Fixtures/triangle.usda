#usda 1.0
(
    customLayerData = {
        string author = "swift-scene tests"
        uint64 identifier = 18446744073709551615
    }
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World" (
    kind = "component"
)
{
    double3 xformOp:translate = (1, 2, 3)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Mesh "Triangle"
    {
        custom float blockedValue = None
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        custom string label = "Triangle — café"
        rel material:binding = </World/Material>
        normal3f[] normals = [(0, 0, 1)] (
            interpolation = "constant"
        )
        custom float optionalValue
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        custom asset preview = @textures/pixel.png@
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (0, 1)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
    }

    def Material "Material"
    {
        custom color3f displayColor = (0.8, 0.2, 0.1)
    }
}

